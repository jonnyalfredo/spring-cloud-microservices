    {
      "name": "02 - Gateway",
      "item": [
        {
          "name": "Rota publica via gateway",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/clients/public/test",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "clients",
                "public",
                "test"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rota publica via gateway respondeu 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rota protegida sem token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/orders",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "api",
