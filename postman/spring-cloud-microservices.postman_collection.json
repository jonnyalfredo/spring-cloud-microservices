    },
    {
      "name": "03 - Clientes",
      "item": [
        {
          "name": "Criar cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set('uniqueEmail', `cliente.${suffix}@email.com`);",
                  "pm.collectionVariables.set('uniqueDocument', `${suffix}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cliente criado com 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('clientId', json.id);",
                  "pm.test('Resposta possui id do cliente', function () {",
                  "  pm.expect(json.id).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente Demo\",\n  \"document\": \"{{uniqueDocument}}\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"phone\": \"11999999999\"\n}"
            },
            "url": {
              "raw": "{{clientBaseUrl}}/clients",
              "host": [
                "{{clientBaseUrl}}"
              ],
              "path": [
                "clients"
              ]
            }
          }
        },
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{clientBaseUrl}}/clients?page=0&size=10&sort=email,asc",
              "host": [
                "{{clientBaseUrl}}"
              ],
              "path": [
                "clients"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "email,asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lista clientes com 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Resposta paginada possui content', function () {",
                  "  pm.expect(pm.response.json().content).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar cliente completo",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente Demo Atualizado\",\n  \"document\": \"{{uniqueDocument}}\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"phone\": \"11777777777\"\n}"
            },
            "url": {
              "raw": "{{clientBaseUrl}}/clients/{{clientId}}",
              "host": [
                "{{clientBaseUrl}}"
              ],
              "path": [
                "clients",
                "{{clientId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Update completo de cliente respondeu 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Nome foi atualizado', function () {",
                  "  pm.expect(pm.response.json().name).to.eql('Cliente Demo Atualizado');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar cliente parcialmente",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"11888888888\"\n}"
            },
            "url": {
              "raw": "{{clientBaseUrl}}/clients/{{clientId}}",
              "host": [
                "{{clientBaseUrl}}"
              ],
              "path": [
                "clients",
                "{{clientId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Patch de cliente respondeu 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Telefone foi atualizado', function () {",
                  "  pm.expect(pm.response.json().phone).to.eql('11888888888');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro de validacao ao criar cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"document\": \"\",\n  \"email\": \"email-invalido\"\n}"
            },
            "url": {
              "raw": "{{clientBaseUrl}}/clients",
              "host": [
                "{{clientBaseUrl}}"
              ],
              "path": [
                "clients"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Validacao de cliente respondeu 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Erro possui correlationId e lista de campos', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.correlationId).to.exist;",
                  "  pm.expect(json.errors).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Pedidos",
      "item": [
        {
          "name": "Criar pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": {{clientId}},\n  \"description\": \"Pedido demo\",\n  \"amount\": 150.00\n}"
            },
            "url": {
              "raw": "{{orderBaseUrl}}/orders",
              "host": [
                "{{orderBaseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pedido criado com 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('orderId', json.id);",
                  "pm.test('Pedido criado com status CREATED', function () {",
                  "  pm.expect(json.status).to.eql('CREATED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/orders?page=0&size=10",
              "host": [
                "{{orderBaseUrl}}"
              ],
              "path": [
                "orders"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lista pedidos com 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Resposta paginada possui content', function () {",
                  "  pm.expect(pm.response.json().content).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Alterar status do pedido",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/orders/{{orderId}}/status?status=PROCESSING",
              "host": [
                "{{orderBaseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "status"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PROCESSING"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status alterado com 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Pedido esta em PROCESSING', function () {",
                  "  pm.expect(pm.response.json().status).to.eql('PROCESSING');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro de validacao ao criar pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": null,\n  \"description\": \"\",\n  \"amount\": 0\n}"
            },
            "url": {
              "raw": "{{orderBaseUrl}}/orders",
              "host": [
                "{{orderBaseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Validacao de pedido respondeu 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Erro possui correlationId e lista de campos', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.correlationId).to.exist;",
                  "  pm.expect(json.errors).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Limpeza",
      "item": [
        {
          "name": "Deletar cliente",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{clientBaseUrl}}/clients/{{clientId}}",
              "host": [
                "{{clientBaseUrl}}"
              ],
              "path": [
                "clients",
                "{{clientId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cliente deletado com 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
