{
  "info": {
    "_postman_id": "b3c9a6de-7d57-4bd5-9d3b-73edb9ab7b11",
    "name": "Spring Cloud Microservices - Clientes e Pedidos",
    "description": "Collection manual para demonstrar o fluxo principal do projeto: health checks, clientes, pedidos, status e erros de validacao.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
